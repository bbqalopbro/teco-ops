// rms_norm: RMS Normalization + optional residual add
// 数据搬运: memcpy_async + memcpy_wait + MemcpyHandle (双缓冲流水)
// 多核划分: Hal Tile R1C32_CR

#include <simd.h>
#include <slave.h>

#include "ual/com/rt.h"
#include "ual/kernel/rms_norm/rms_norm.h"

#include "teco_hal_tensor.hpp"
#include "teco_hal_tile.hpp"
#include "teco_hal_dma.hpp"

using namespace tecoops::ual::args;  // NOLINT
using namespace teco::hal;            // NOLINT

// ================================================================
// Kernel 0: 纯 RMSNorm (Hal DMA: dma_get / dma_put)
// ================================================================
__global__ void teco_slave_rms_norm_fp16(RmsNormArgs args) {
    const int N = args.num_tokens;
    const int D = args.hidden_size;
    const float eps = args.eps;

    half *input_hbm  = static_cast<half *>(const_cast<void *>(args.input));
    half *weight_hbm = static_cast<half *>(const_cast<void *>(args.weight));
    half *output_hbm = static_cast<half *>(args.output);

    // Step 1: Hal Tensor 包装 (HBM)
    Tensor<half, 2> input_gm(input_hbm, {static_cast<size_t>(N), static_cast<size_t>(D)});
    Tensor<half, 2> output_gm(output_hbm, {static_cast<size_t>(N), static_cast<size_t>(D)});

    // Step 2: Hal Tile R1C32_CR 行并行
    auto tile = make_tile<SplitMode::R1C32_CR>(
        input_gm, {static_cast<size_t>(N), static_cast<size_t>(D)});
    auto block = tile.compute_core_block_shape();
    int my_rows = static_cast<int>(block[0]);
    if (my_rows == 0) return;
    int my_cols = static_cast<int>(block[1]);

    // Step 3: SPM 分配 (按 tile block 大小)
    const size_t row_bytes = static_cast<size_t>(D) * sizeof(half);
    const size_t block_bytes = static_cast<size_t>(my_rows) * row_bytes;
    half *spm_input  = static_cast<half *>(rt_spm_malloc(block_bytes));
    half *spm_output = static_cast<half *>(rt_spm_malloc(block_bytes));
    half *spm_weight = static_cast<half *>(rt_spm_malloc(row_bytes));

    Tensor<half, 2> input_spm(spm_input, {static_cast<size_t>(my_rows), static_cast<size_t>(D)});
    Tensor<half, 2> output_spm(spm_output, {static_cast<size_t>(my_rows), static_cast<size_t>(D)});

    // Step 4: 加载 weight (直接 memcpy, weight 不参与 tile 划分)
    memcpy(spm_weight, weight_hbm, row_bytes);

    // Step 5: Hal DMA: HBM -> SPM
    DmaQueue dma;
    dma.dma_get(input_spm, input_gm, tile);
    dma.wait_get();

    // Step 6: 计算
    for (int r = 0; r < my_rows; ++r) {
        half *row = spm_input + r * D;
        float sum_sq = 0.0f;
        for (int d = 0; d < D; ++d) {
            float val = static_cast<float>(row[d]);
            sum_sq += val * val;
        }
        float rstd = 1.0f / sqrtf(sum_sq / static_cast<float>(D) + eps);

        half *row_out = spm_output + r * D;
        for (int d = 0; d < D; ++d) {
            float val = static_cast<float>(row[d]) * rstd
                        * static_cast<float>(spm_weight[d]);
            row_out[d] = static_cast<half>(val);
        }
    }

    // Step 7: Hal DMA: SPM -> HBM
    dma.dma_put(output_gm, output_spm, tile);
    dma.wait_put();

    rt_spm_free(spm_input);
    rt_spm_free(spm_output);
    rt_spm_free(spm_weight);
}

// ================================================================
// Kernel 1: RMSNorm + residual add (Hal DMA: dma_get / dma_put)
// ================================================================
__global__ void teco_slave_rms_norm_fp16_add(RmsNormArgs args) {
    const int N = args.num_tokens;
    const int D = args.hidden_size;
    const float eps = args.eps;

    half *input_hbm     = static_cast<half *>(const_cast<void *>(args.input));
    half *weight_hbm    = static_cast<half *>(const_cast<void *>(args.weight));
    half *residual_hbm  = static_cast<half *>(const_cast<void *>(args.residual));
    half *output_hbm    = static_cast<half *>(args.output);
    half *res_out_hbm   = static_cast<half *>(args.residual_out);

    // Step 1: Hal Tensor 包装 (HBM)
    Tensor<half, 2> input_gm(input_hbm, {static_cast<size_t>(N), static_cast<size_t>(D)});
    Tensor<half, 2> residual_gm(residual_hbm, {static_cast<size_t>(N), static_cast<size_t>(D)});
    Tensor<half, 2> output_gm(output_hbm, {static_cast<size_t>(N), static_cast<size_t>(D)});
    Tensor<half, 2> res_out_gm(res_out_hbm, {static_cast<size_t>(N), static_cast<size_t>(D)});

    // Step 2: Hal Tile R1C32_CR 行并行
    auto tile = make_tile<SplitMode::R1C32_CR>(
        input_gm, {static_cast<size_t>(N), static_cast<size_t>(D)});
    auto block = tile.compute_core_block_shape();
    int my_rows = static_cast<int>(block[0]);
    if (my_rows == 0) return;

    // Step 3: SPM 分配 (按 tile block 大小)
    const size_t row_bytes = static_cast<size_t>(D) * sizeof(half);
    const size_t block_bytes = static_cast<size_t>(my_rows) * row_bytes;
    half *spm_input    = static_cast<half *>(rt_spm_malloc(block_bytes));
    half *spm_residual = static_cast<half *>(rt_spm_malloc(block_bytes));
    half *spm_output   = static_cast<half *>(rt_spm_malloc(block_bytes));
    half *spm_weight   = static_cast<half *>(rt_spm_malloc(row_bytes));

    Tensor<half, 2> input_spm(spm_input, {static_cast<size_t>(my_rows), static_cast<size_t>(D)});
    Tensor<half, 2> residual_spm(spm_residual, {static_cast<size_t>(my_rows), static_cast<size_t>(D)});
    Tensor<half, 2> output_spm(spm_output, {static_cast<size_t>(my_rows), static_cast<size_t>(D)});

    // Step 4: 加载 weight (直接 memcpy)
    memcpy(spm_weight, weight_hbm, row_bytes);

    // Step 5: Hal DMA: HBM -> SPM (input + residual)
    DmaQueue dma;
    dma.dma_get(input_spm, input_gm, tile);
    dma.dma_get(residual_spm, residual_gm, tile);
    dma.wait_get(2);

    // Step 6: Add residual + RMS Norm
    for (int r = 0; r < my_rows; ++r) {
        half *row_in  = spm_input + r * D;
        half *row_res = spm_residual + r * D;
        float sum_sq = 0.0f;
        for (int d = 0; d < D; ++d) {
            float val = static_cast<float>(row_in[d])
                        + static_cast<float>(row_res[d]);
            row_res[d] = static_cast<half>(val);  // residual_out (skip connection)
            sum_sq += val * val;
        }
        float rstd = 1.0f / sqrtf(sum_sq / static_cast<float>(D) + eps);
        half *row_out = spm_output + r * D;
        for (int d = 0; d < D; ++d) {
            float val = static_cast<float>(row_res[d]) * rstd
                        * static_cast<float>(spm_weight[d]);
            row_out[d] = static_cast<half>(val);
        }
    }

    // Step 7: Hal DMA: SPM -> HBM (output + residual_out)
    dma.dma_put(output_gm, output_spm, tile);
    dma.dma_put(res_out_gm, residual_spm, tile);
    dma.wait_put(2);

    rt_spm_free(spm_input);
    rt_spm_free(spm_residual);
    rt_spm_free(spm_output);
    rt_spm_free(spm_weight);
}
